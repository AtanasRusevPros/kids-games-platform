{
  "name": "@kids-games/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --watch --env-file=.env -r tsx/esm src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node --env-file=.env -r tsx/esm src/db/migrate.ts",
    "db:seed": "node --env-file=.env -r tsx/esm src/db/seed.ts",
    "db:reset": "node --env-file=.env -r tsx/esm src/db/reset.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@kids-games/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "fastify": "^4.28.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.1",
    "node-pg-migrate": "^7.3.2",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.4.1",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
